{
  "manifest_version": 3,
  "name": "Travel Capture",
  "version": "1.0",
  "description": "Screenshot any booking confirmation, read it with AI, send to your travel app.",
  "permissions": ["activeTab", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture Reservation",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
